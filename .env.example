# Copia este archivo como .env.local y sustituye solo estos marcadores.
# No añadas aquí una secret key ni una service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Solo servidor: no uses el prefijo NEXT_PUBLIC_ ni compartas estos valores.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Haircut Style <reservas@your-verified-domain.example>
